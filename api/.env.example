# Note:
# - `dashboard/api/db.py` reads `dashboard/api/.env`.
# - `dashboard/api/auth.py` currently reads `dashboard/.env` instead of this file.
# - Production recommendation: inject real environment variables from systemd / Docker / Kubernetes.
# - If you still rely on local `.env` files, keep auth-related values (`API_KEY`, `TENANT_ID`, `DASHBOARD_API_KEYS`)
#   in both places so DB config and auth config do not drift apart.

# DATABASE_URL
# Required: yes
# Description: PostgreSQL DSN used by asyncpg. Use `postgresql://...` or `postgres://...`; do not use SQLAlchemy's `postgresql+asyncpg://...`.
# Production: use a managed PostgreSQL endpoint with SSL enabled and least-privilege credentials.
# Example: postgresql://dashboard:strong-password@db.example.com:5432/dashboard?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard

# API_KEY
# Required: yes in single-tenant mode; no when every tenant key is managed through DASHBOARD_API_KEYS
# Description: Static X-API-Key value for single-tenant deployments or local development.
# Production: prefer long random hex generated by `openssl rand -hex 32`; leave blank if you only use DASHBOARD_API_KEYS.
# Example: 0123456789abcdef0123456789abcdef
API_KEY=

# DASHBOARD_API_KEYS
# Required: yes in multi-tenant mode; no in single-tenant mode
# Description: Comma-separated `api_key:tenant_id` pairs loaded by auth.py, for example `key1:101,key2:102`.
# Production: use one unique key per customer subdomain and keep the mapping synchronized with Nginx Host routing.
# Example: a1b2c3d4e5f6a7b8c9d0a1b2c3d4e5f6:101,fedcba9876543210fedcba9876543210:102
DASHBOARD_API_KEYS=

# TENANT_ID
# Required: yes in single-tenant mode; no when every tenant is resolved from DASHBOARD_API_KEYS
# Description: Integer tenant id used by auth fallback and startup self-check. In single-tenant mode it must be a real tenant id, not the default `1`.
# Production: set this to the tenant row id returned from `INSERT INTO tenants ... RETURNING id`.
# Example: 101
TENANT_ID=

# DB_SCHEMA
# Required: no
# Default: public
# Description: PostgreSQL search_path schema set on every asyncpg connection.
# Production: keep `public` unless your database already isolates the app in a dedicated schema and you understand the impact on psql/init scripts.
# Example: public
DB_SCHEMA=public

# DB_POOL_MIN_SIZE
# Required: no
# Default: 1
# Description: Minimum asyncpg pool size.
# Production: start with 2-4 on a small instance and scale with database max connections.
# Example: 2
DB_POOL_MIN_SIZE=1

# DB_POOL_MAX_SIZE
# Required: no
# Default: 10
# Description: Maximum asyncpg pool size.
# Production: set this below the database connection limit after accounting for all app replicas.
# Example: 20
DB_POOL_MAX_SIZE=10

# DB_COMMAND_TIMEOUT
# Required: no
# Default: 30
# Description: Default asyncpg command timeout in seconds.
# Production: keep 30 unless slow analytical queries routinely exceed it and you have verified they are expected.
# Example: 30
DB_COMMAND_TIMEOUT=30

# DB_STATEMENT_CACHE_SIZE
# Required: no
# Default: 100
# Description: asyncpg statement cache size.
# Production: keep the default unless you have a measured reason to increase or disable it.
# Example: 100
DB_STATEMENT_CACHE_SIZE=100

# LOG_LEVEL
# Required: no
# Default: INFO
# Description: dashboard-api root log level.
# Production: use INFO by default; temporarily switch to DEBUG only during incident diagnosis.
# Example: INFO
LOG_LEVEL=INFO

# ENABLE_EXPLORE
# Required: no
# Default: disabled
# Description: Enables `/api/explore/tables` and `/api/explore/sample` debug endpoints.
# Production: keep this unset or set to `0`; only enable in a locked-down dev/staging environment.
# Example: 0
ENABLE_EXPLORE=0

# DASHBOARD_WARMUP_TENANT_IDS
# Required: no
# Default: derived from DASHBOARD_API_KEYS, otherwise TENANT_ID
# Description: Comma-separated tenant ids whose dashboard caches are warmed on startup and refreshed every 60 seconds.
# Production: set the most active tenant ids explicitly if you want deterministic warm cache behavior after deploy.
# Example: 101,102
DASHBOARD_WARMUP_TENANT_IDS=

# CORS_ORIGINS
# Required: no
# Default: not used by current code
# Description: Placeholder only. Current `dashboard/api/main.py` hard-codes `allow_origins=["*"]` and does not read this variable.
# Production: changing this variable alone has no effect; tightening CORS currently requires a code change.
# Example: https://customer-a.example.com,https://customer-b.example.com
# CORS_ORIGINS=
