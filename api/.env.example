# ==== 必填（交付时只需改这两行） ====
# PostgreSQL 连接串。格式 postgresql://user:pass@host:port/dbname
DATABASE_URL=
# 当前租户 ID（对应 users.tenant_id）
TENANT_ID=

# ==== 可选（通常无需改动） ====
# 开发 API Key，前端访问后端时 header X-API-Key 用
API_KEY=dev-key-guazi-2026
# PG schema，默认 public
DB_SCHEMA=public

# Enable /api/explore/* endpoints for dev only (never set in prod)
# ENABLE_EXPLORE=1
